{
  "name": "mywebsite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "dev": "next dev",
    "build": "rm -rf out && next build && mkdir -p out && cp -r .next/static out/.next/ && touch out/.nojekyll",
    "start": "next start",
    "lint": "next lint",
    "deploy": "yarn build && gh-pages -d out -b gh-pages --dotfiles"
  },
  "dependencies": {
    "@babel/runtime": "^7.27.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.2",
    "@mui/material": "^7.0.2",
    "next": "15.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.1",
    "gh-pages": "^6.3.0",
    "prettier": "^3.5.3",
    "typescript": "^5"
  }
}
