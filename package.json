{
  "name": "mywebsite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "dev": "next dev",
    "build": "next build",
    "export": "rimraf out && next build && mkdirp out && cpx \".next/static/**/*\" out/.next/static && echo. > out/.nojekyll",
    "start": "next start",
    "lint": "next lint",
    "deploy": "yarn export && gh-pages -d out -b gh-pages --dotfiles"
  },
  "dependencies": {
    "@babel/runtime": "^7.27.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.2",
    "@mui/material": "^7.0.2",
    "next": "15.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cpx": "^1.5.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.1",
    "gh-pages": "^6.3.0",
    "mkdirp": "^3.0.1",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "typescript": "^5"
  }
}
